{
  "name": "dsh-offpeak-queue",
  "version": "0.2.1",
  "type": "module",
  "description": "Off-peak task queue: type /闲时任务 in a conversation to queue a task without any model call; DSH runs it in the same conversation during DeepSeek off-peak (half-price) hours.",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomas-zz/dsh-offpeak-queue.git"
  },
  "homepage": "https://github.com/Thomas-zz/dsh-offpeak-queue",
  "bugs": {
    "url": "https://github.com/Thomas-zz/dsh-offpeak-queue/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "off-peak",
    "queue",
    "deepseek"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/ARCHITECTURE.md",
    "docs/screenshots/*.png",
    "scripts/*.mjs",
    "scripts/*.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "repair:sessions": "node scripts/repair-session-logs.mjs"
  }
}
